% The look shared by both languages of the user's playbook: page, type,
% colours, the boxes and the cover. Each language's .tex holds only the text,
% and loads this with its language as the option:
%
%   \usepackage[spanish]{sheriff-playbook}
%
% The version on the cover and in the footer is \playbookversion, which
% scripts/playbook.sh defines from the poms or from the release's tag, and the
% Maven plugin's example uses \pluginversion, from the plugin's pom.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{sheriff-playbook}[2026/10/07 The Sheriff tools' user playbook]

\newif\ifpb@spanish
\DeclareOption{spanish}{\pb@spanishtrue}
\DeclareOption{english}{\pb@spanishfalse}
\ProcessOptions\relax

\providecommand\playbookversion{dev}
% The Maven plugin's own version, for its example: the build reads it from the
% plugin's pom, as a prerelease tag is not a version the plugin has.
\providecommand\pluginversion{\playbookversion}

% Type and page.
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\ifpb@spanish
  \RequirePackage[english,spanish,es-noshorthands,es-tabla,es-nolayout,es-noindentfirst]{babel}
\else
  \RequirePackage[spanish,english]{babel}
\fi
\RequirePackage[default,semibold]{sourcesanspro}
\RequirePackage[scale=0.86]{sourcecodepro}
\RequirePackage[a4paper,top=27mm,bottom=26mm,inner=25mm,outer=25mm,headsep=9mm,footskip=13mm]{geometry}
\RequirePackage{microtype}
% Source Code Pro joins -- into a dash, and --check must read as typed.
\DisableLigatures[-]{encoding=T1,family=tt*}
\RequirePackage[table]{xcolor}
\RequirePackage{graphicx}
\RequirePackage{amssymb}
\RequirePackage{fontawesome5}
\RequirePackage{tikz}
\usetikzlibrary{arrows.meta,positioning,calc,fit,backgrounds,shapes.geometric}
\RequirePackage[most]{tcolorbox}
\RequirePackage{listings}
\RequirePackage{enumitem}
\RequirePackage{titlesec}
\RequirePackage{titletoc}
\RequirePackage{needspace}
\RequirePackage{etoolbox}
\RequirePackage{fancyhdr}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{array}
\RequirePackage{lastpage}
\RequirePackage[obeyspaces,spaces]{url}
\RequirePackage{hyperref}

\setlength{\parindent}{0pt}
% A long command or path in a line of prose: a looser line, never one past the margin.
\setlength{\emergencystretch}{3em}
\setlength{\parskip}{0.55\baselineskip}
\linespread{1.08}
\setlist{itemsep=0.25\baselineskip,topsep=0.2\baselineskip,parsep=0pt}
\setlist[itemize]{label=\textcolor{pbaccent}{\small\textbullet},leftmargin=1.4em}
\setlist[enumerate]{label=\textcolor{pbbrand}{\bfseries\arabic*.},leftmargin=1.7em}

% Colours: a deep navy for structure, a slate blue for the small marks, and
% one colour per kind of callout. Nothing bright: this is a manual.
\definecolor{pbbrand}{HTML}{14324F}
\definecolor{pbbranddark}{HTML}{0B1F33}
\definecolor{pbaccent}{HTML}{4A6785}
\definecolor{pbaccentsoft}{HTML}{EEF2F6}
\definecolor{pbink}{HTML}{1F2933}
\definecolor{pbmuted}{HTML}{5F6B7A}
\definecolor{pbrule}{HTML}{D5DBE3}
\definecolor{pbcode}{HTML}{F3F5F8}
\definecolor{pbtip}{HTML}{0F766E}
\definecolor{pbtipsoft}{HTML}{E6F4F2}
\definecolor{pbwarn}{HTML}{B4461B}
\definecolor{pbwarnsoft}{HTML}{FCEDE6}
\definecolor{pbnote}{HTML}{2F5D8A}
\definecolor{pbnotesoft}{HTML}{E8EFF7}
\color{pbink}

